      "parameters": {
        "jsCode": "return $input.first().json.jobs.map(job => {\n  // Strip all HTML tags completely\n  let textOnly = job.description ? job.description.replace(/<[^>]*>?/gm, ' ') : \"\";\n  \n  return {\n    json: {\n      title: job.title,\n      company_name: job.company_name,\n      url: job.url,\n      // ONLY take the first 400 characters to save massive amounts of tokens\n      short_description: textOnly.substring(0, 400)\n    }\n  };\n});"
      },
